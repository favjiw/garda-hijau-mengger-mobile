<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Baris riwayat" di beranda Sampah. Garis pemisah dipasang lewat ItemDecoration di fragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Kotak tanggal -->
    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_ghm_kotak_tanggal"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTanggalHari"
            style="@style/Text.GHM.JudulBagian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/ghm_daun_900"
            tools:text="12" />

        <TextView
            android:id="@+id/tvTanggalBulan"
            style="@style/Text.GHM.Kecil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textSize="14sp"
            tools:text="Nov" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvJumlahVolumeSampah"
            style="@style/Text.GHM.Tebal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="230 kg masuk" />

        <TextView
            android:id="@+id/tvHasilPencacahan"
            style="@style/Text.GHM.Kecil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Pukul 08.30. Banyak sisa sayur dari pasar" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ghm_chevron_kanan" />
</LinearLayout>
