<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Redesign v2 / "03 Catat sampah" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghm_kertas"
    android:orientation="vertical"
    tools:context=".ui.pencatatan_history.tambah_riwayat.TambahRiwayatActivity">

    <!-- Bilah atas. Padding atas ditambah tinggi status bar di TambahRiwayatActivity. -->
    <LinearLayout
        android:id="@+id/layoutBilahAtas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKembali"
            style="@style/Widget.GHM.Button.Bulat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/ghm_kembali"
            app:icon="@drawable/ic_ghm_kembali"
            app:iconSize="24dp" />

        <TextView
            style="@style/Text.GHM.JudulBagian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:accessibilityHeading="true"
            android:text="@string/ghm_catat_judul" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Text.GHM.Biasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ghm_catat_subjudul"
                android:textColor="@color/ghm_tinta_redup" />

            <!-- Tanggal & pukul: keduanya mengisi tanggalWaktu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.GHM.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/inputTanggalRiwayat"
                        android:text="@string/ghm_label_tanggal" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/edtTanggalWaktu"
                        style="@style/Widget.GHM.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/ghm_daun_500"
                        app:boxStrokeWidth="1.5dp"
                        app:endIconContentDescription="@string/ghm_pilih_tanggal"
                        app:endIconDrawable="@drawable/ic_ghm_kalender"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputTanggalRiwayat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:fontFamily="@font/atkinson_bold"
                            android:inputType="none"
                            android:maxLines="1"
                            tools:text="12 Nov 2026" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.GHM.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/inputPukul"
                        android:text="@string/ghm_label_pukul" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/edtPukul"
                        style="@style/Widget.GHM.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/ghm_daun_500"
                        app:boxStrokeWidth="1.5dp"
                        app:endIconContentDescription="@string/ghm_pilih_pukul"
                        app:endIconDrawable="@drawable/ic_ghm_jam"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPukul"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:fontFamily="@font/atkinson_bold"
                            android:inputType="none"
                            android:maxLines="1"
                            tools:text="08.30" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Berat sampah (totalSampah) -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/inputTotalSampah"
                android:text="@string/ghm_label_berat" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBerat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/ghm_daun_500"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKurang"
                        style="@style/Widget.GHM.Button.Bulat"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/ghm_kurangi_berat"
                        app:backgroundTint="@color/ghm_tunas_100"
                        app:icon="@drawable/ic_ghm_kurang"
                        app:iconSize="26dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:baselineAligned="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/inputTotalSampah"
                            style="@style/Text.GHM.AngkaBesar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="center"
                            android:hint="@string/ghm_hint_berat"
                            android:importantForAutofill="no"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:maxLength="7"
                            android:minWidth="48dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColorHint="@color/ghm_garis"
                            tools:text="230" />

                        <TextView
                            style="@style/Text.GHM.JudulBagian"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:importantForAccessibility="no"
                            android:text="@string/ghm_satuan_kg"
                            android:textColor="@color/ghm_daun_900" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTambah"
                        style="@style/Widget.GHM.Button.Bulat"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/ghm_tambah_berat"
                        app:backgroundTint="@color/ghm_tunas_100"
                        app:icon="@drawable/ic_ghm_tambah"
                        app:iconSize="26dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvGalatBerat"
                style="@style/Text.GHM.Galat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ghm_galat_berat_kosong"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Catatan -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/inputKeterangan"
                android:text="@string/ghm_label_catatan_opsional" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edtCatatan"
                style="@style/Widget.GHM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputKeterangan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/ghm_hint_catatan"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Aksi bawah. Padding bawah ditambah tinggi navigation bar / keyboard di TambahRiwayatActivity. -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ghm_tombol_simpan_catatan" />
    </LinearLayout>

</LinearLayout>
