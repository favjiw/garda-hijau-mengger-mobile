<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Redesign v2 / "04 Maggot — kandang" -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghm_kertas"
    tools:context=".ui.prediksi.PrediksiFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/layoutAksi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <!-- Kepala: jumlah siklus dan judul -->
            <TextView
                android:id="@+id/tvJumlahSiklus"
                style="@style/Text.GHM.Kecil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                tools:text="3 siklus"
                tools:visibility="visible" />

            <TextView
                style="@style/Text.GHM.JudulLayar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityHeading="true"
                android:text="@string/ghm_maggot_judul" />

            <!-- Kartu hijau: perkiraan total panen (GET prediksi/total) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPerkiraan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/ghm_daun_700"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.GHM.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/ghm_perkiraan_total"
                        android:textColor="@color/ghm_tunas_100" />

                    <LinearLayout
                        android:id="@+id/layoutTotalPerkiraan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTotalPerkiraan"
                            style="@style/Text.GHM.AngkaBesar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ghm_putih"
                            tools:text="25" />

                        <TextView
                            style="@style/Text.GHM.JudulBagian"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/ghm_satuan_kg"
                            android:textColor="@color/ghm_putih" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSubPerkiraan"
                        style="@style/Text.GHM.Kecil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/ghm_tunas_100"
                        tools:text="dari 2 siklus yang sudah punya perkiraan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSiklusKosong"
                style="@style/Text.GHM.Kecil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ghm_kartu"
                android:padding="20dp"
                android:text="@string/ghm_siklus_kosong"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_prediksi_siklus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_card_prediksi_siklus" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutAksi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulaiSiklus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ghm_tombol_mulai_siklus" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
