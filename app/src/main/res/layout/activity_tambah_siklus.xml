<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Redesign v2 / "06 Mulai siklus" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghm_kertas"
    android:orientation="vertical"
    tools:context=".ui.prediksi.tambah_siklus.TambahSiklusActivity">

    <!-- Bilah atas. Padding atas ditambah tinggi status bar di TambahSiklusActivity. -->
    <LinearLayout
        android:id="@+id/layoutBilahAtas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKembali"
            style="@style/Widget.GHM.Button.Bulat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/ghm_kembali"
            app:icon="@drawable/ic_ghm_kembali"
            app:iconSize="24dp" />

        <TextView
            style="@style/Text.GHM.JudulBagian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:accessibilityHeading="true"
            android:text="@string/ghm_mulai_siklus_judul" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Tanggal mulai -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/inputTanggal"
                android:text="@string/ghm_label_tanggal_mulai" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edtTanggal"
                style="@style/Widget.GHM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/ghm_daun_500"
                app:boxStrokeWidth="1.5dp"
                app:endIconContentDescription="@string/ghm_pilih_tanggal"
                app:endIconDrawable="@drawable/ic_ghm_kalender"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTanggal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/atkinson_bold"
                    android:inputType="none"
                    android:maxLines="1"
                    tools:text="Kamis, 12 November 2026" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Jumlah telur -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/inputJumlahTelur"
                android:text="@string/ghm_label_jumlah_telur" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edtJumlahTelur"
                style="@style/Widget.GHM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="@string/ghm_bantuan_jumlah_telur"
                app:helperTextTextAppearance="@style/TextAppearance.GHM.Bantuan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputJumlahTelur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ghm_hint_jumlah_telur"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Media telur: pilihan dari GET /api/prediksi/opsi (dibuat di TambahSiklusActivity) -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ghm_label_media_telur" />

            <LinearLayout
                android:id="@+id/layoutPilihanMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvMediaMemuat"
                style="@style/Text.GHM.Kecil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ghm_memuat_pilihan_media"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layoutMediaGagal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ghm_kartu"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvMediaGagal"
                    style="@style/Text.GHM.Kecil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Layanan AI sedang tidak tersedia. Coba lagi nanti." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMuatUlangMedia"
                    style="@style/Widget.GHM.Button.Saran"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ghm_coba_lagi" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMediaError"
                style="@style/Text.GHM.Galat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ghm_galat_media_kosong"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Catatan -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/inputCatatan"
                android:text="@string/ghm_label_catatan_opsional" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edtCatatan"
                style="@style/Widget.GHM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputCatatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/ghm_hint_catatan_siklus"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Aksi bawah. Padding bawah ditambah tinggi navigation bar / keyboard di TambahSiklusActivity. -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpanSiklus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ghm_tombol_mulai_siklus_simpan" />
    </LinearLayout>

</LinearLayout>
