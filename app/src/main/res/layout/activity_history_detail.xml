<?xml version="1.0" encoding="utf-8"?>
<!-- Detail satu catatan sampah (dibuka dari Riwayat di tab Sampah). Memakai komponen Redesign v2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghm_kertas"
    android:orientation="vertical"
    tools:context=".ui.pencatatan_history.detail_pencatatan_history.HistoryDetailActivity">

    <!-- Bilah atas. Padding atas ditambah tinggi status bar di HistoryDetailActivity. -->
    <LinearLayout
        android:id="@+id/layoutBilahAtas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKembali"
            style="@style/Widget.GHM.Button.Bulat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/ghm_kembali"
            app:icon="@drawable/ic_ghm_kembali"
            app:iconSize="24dp" />

        <TextView
            style="@style/Text.GHM.JudulBagian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:accessibilityHeading="true"
            android:text="@string/ghm_detail_catatan_judul" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollIsi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvTanggalWaktu"
                style="@style/Text.GHM.JudulLayar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Kamis, 12 November 2026" />

            <TextView
                android:id="@+id/tvWaktu"
                style="@style/Text.GHM.Kecil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Pukul 08.15" />

            <!-- Berat sampah -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_ghm_kartu"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Text.GHM.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:text="@string/ghm_label_berat"
                    android:textColor="@color/ghm_tinta_redup" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTotalSampah"
                        style="@style/Text.GHM.AngkaBesar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="230" />

                    <TextView
                        style="@style/Text.GHM.JudulBagian"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/ghm_satuan_kg"
                        android:textColor="@color/ghm_daun_900" />
                </LinearLayout>
            </LinearLayout>

            <!-- Catatan -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ghm_label_catatan" />

            <TextView
                android:id="@+id/tvCatatan"
                style="@style/Text.GHM.Biasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ghm_kartu"
                android:padding="20dp"
                tools:text="Banyak sisa sayur dari pasar" />

            <TextView
                android:id="@+id/tvCreatedAt"
                style="@style/Text.GHM.Kecil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                tools:text="Dicatat 12 November 2026" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
