<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: komponen "Kartu siklus" di "04 Maggot — kandang" -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvJudulSiklus"
                style="@style/Text.GHM.JudulBagian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Siklus 3" />

            <TextView
                android:id="@+id/tvHariKe"
                style="@style/Text.GHM.Tebal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ghm_chip"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/ghm_daun_700"
                tools:text="Hari ke-12" />
        </LinearLayout>

        <include
            android:id="@+id/pita"
            layout="@layout/view_ghm_pita_siklus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPerkiraan"
                    style="@style/Text.GHM.Tebal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Perkiraan 10 kg" />

                <TextView
                    android:id="@+id/tvKeterangan"
                    style="@style/Text.GHM.Kecil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Mulai 31 Okt 2026" />
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ghm_chevron_kanan" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
