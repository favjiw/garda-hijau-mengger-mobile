<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Redesign v2 / "02 Sampah — beranda" -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghm_kertas"
    tools:context=".ui.pencatatan_history.PencatatanHistoryFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/layoutAksi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Kepala: sapaan, judul, notifikasi, keluar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_selamat_pagi"
                        style="@style/Text.GHM.Kecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ghm_sapaan" />

                    <TextView
                        android:id="@+id/tvCek"
                        style="@style/Text.GHM.JudulLayar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ghm_sampah_judul" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/img_notification"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ghm_lingkaran_putih"
                    android:clickable="true"
                    android:contentDescription="@string/ghm_notifikasi"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ghm_bell" />

                    <!-- Titik kuning: tampilkan bila ada notifikasi belum dibaca -->
                    <View
                        android:id="@+id/viewNotifBaru"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="11dp"
                        android:layout_marginEnd="11dp"
                        android:background="@drawable/bg_ghm_titik_baru"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/img_logout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_ghm_lingkaran_putih"
                    android:clickable="true"
                    android:contentDescription="@string/ghm_keluar"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/img_btn_logout"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ghm_keluar" />
                </FrameLayout>
            </LinearLayout>

            <!-- Kartu ringkasan minggu ini -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTotalMinggu"
                            style="@style/Text.GHM.AngkaBesar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="1.240" />

                        <TextView
                            style="@style/Text.GHM.JudulBagian"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/ghm_satuan_kg"
                            android:textColor="@color/ghm_daun_900" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRentangMinggu"
                        style="@style/Text.GHM.Kecil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        tools:text="masuk dalam 7 hari terakhir, 6–12 November" />

                    <com.codelabs.gardahijau.ui.widget.WeeklyBarChartView
                        android:id="@+id/chartMingguan"
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:layout_marginTop="16dp"
                        android:contentDescription="@string/ghm_grafik_deskripsi" />

                    <TextView
                        android:id="@+id/tvInsight"
                        style="@style/Text.GHM.Kecil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        tools:text="Sabtu paling banyak, 260 kg." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvRiwayatPencacahan"
                style="@style/Text.GHM.JudulBagian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/ghm_riwayat" />

            <TextView
                android:id="@+id/tvRiwayatKosong"
                style="@style/Text.GHM.Kecil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ghm_kartu"
                android:padding="20dp"
                android:text="@string/ghm_riwayat_kosong"
                android:visibility="gone" />

            <!-- Satu kartu putih berisi baris-baris riwayat, dipisah garis tipis -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_prediksi_siklus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ghm_kartu"
                android:nestedScrollingEnabled="false"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                tools:itemCount="3"
                tools:listitem="@layout/item_card_history_pencacahan" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutAksi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCatatSampah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ghm_tombol_catat_sampah" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
