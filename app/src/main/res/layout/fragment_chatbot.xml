<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Redesign v2 / "09 GardaBot". Tab ketiga di MainActivity (navigasi bawah dari activity_main.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghm_kertas"
    android:orientation="vertical"
    tools:context=".ui.chatbot.ChatbotFragment">

    <!-- Kepala. Tinggi status bar sudah ditangani MainActivity. Tab utama: tanpa tombol kembali. -->
    <LinearLayout
        android:id="@+id/layoutKepala"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.GHM.JudulLayar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/ghm_gardabot_judul" />

            <TextView
                style="@style/Text.GHM.Kecil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ghm_gardabot_subjudul" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ghm_garis" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="13dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Sapaan pembuka (teks tetap, bukan dari server) -->
            <include
                android:id="@+id/sapaan"
                layout="@layout/item_chat_received" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_chat_received" />

            <!-- Saran pertanyaan -->
            <LinearLayout
                android:id="@+id/layoutSaran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.GHM.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ghm_coba_tanyakan"
                    android:textColor="@color/ghm_tinta_redup" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSuggestion1"
                    style="@style/Widget.GHM.Button.Saran"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ghm_saran_menetas" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSuggestion2"
                    style="@style/Widget.GHM.Button.Saran"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ghm_saran_pakan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSuggestion3"
                    style="@style/Widget.GHM.Button.Saran"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ghm_saran_dilarang" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tulis pesan. Padding bawah ditambah tinggi keyboard di ChatbotFragment. -->
    <LinearLayout
        android:id="@+id/chatContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/edtMessage"
            style="@style/Text.GHM.Biasa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_ghm_kotak_pesan"
            android:hint="@string/ghm_hint_pertanyaan"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:maxLines="4"
            android:minHeight="54dp"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:textColorHint="@color/ghm_tinta_redup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="@style/Widget.GHM.Button.Bulat"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/ghm_kirim"
            app:backgroundTint="@color/ghm_daun_700"
            app:icon="@drawable/ic_ghm_kirim"
            app:iconSize="22dp"
            app:rippleColor="@color/ghm_daun_500" />
    </LinearLayout>

</LinearLayout>
