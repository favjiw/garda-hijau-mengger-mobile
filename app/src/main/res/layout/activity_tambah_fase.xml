<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Redesign v2 / "07 Catat fase besar" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghm_kertas"
    android:orientation="vertical"
    tools:context=".ui.prediksi.tambah_fase.TambahFaseActivity">

    <!-- Bilah atas. Padding atas ditambah tinggi status bar di TambahFaseActivity. -->
    <LinearLayout
        android:id="@+id/layoutBilahAtas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKembali"
            style="@style/Widget.GHM.Button.Bulat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/ghm_kembali"
            app:icon="@drawable/ic_ghm_kembali"
            app:iconSize="24dp" />

        <TextView
            style="@style/Text.GHM.JudulBagian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:accessibilityHeading="true"
            android:text="@string/ghm_catat_fase_besar_judul" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Kartu siklus: tahap yang sedang dicatat (Besar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ghm_kartu"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvJudulSiklus"
                        style="@style/Text.GHM.Tebal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Siklus 3" />

                    <TextView
                        android:id="@+id/tvHariKe"
                        style="@style/Text.GHM.Kecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:text="Hari ke-12"
                        tools:visibility="visible" />
                </LinearLayout>

                <include
                    android:id="@+id/pita"
                    layout="@layout/view_ghm_pita_siklus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Tanggal -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/inputTanggalPembesaran"
                android:text="@string/ghm_label_tanggal_fase_besar" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edtTanggalPembesaran"
                style="@style/Widget.GHM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/ghm_daun_500"
                app:boxStrokeWidth="1.5dp"
                app:endIconContentDescription="@string/ghm_pilih_tanggal"
                app:endIconDrawable="@drawable/ic_ghm_kalender"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTanggalPembesaran"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/atkinson_bold"
                    android:inputType="none"
                    android:maxLines="1"
                    tools:text="Minggu, 8 November 2026" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Jumlah pakan (jumlahMakanan) -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/inputJumlahMakanan"
                android:text="@string/ghm_label_jumlah_pakan" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edtJumlahPakan"
                style="@style/Widget.GHM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="@string/ghm_bantuan_jumlah_pakan"
                app:helperTextTextAppearance="@style/TextAppearance.GHM.Bantuan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputJumlahMakanan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ghm_hint_jumlah_pakan"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Keterangan -->
            <TextView
                style="@style/Text.GHM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/inputKeterangan"
                android:text="@string/ghm_label_keterangan_opsional" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edtKeterangan"
                style="@style/Widget.GHM.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputKeterangan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/ghm_hint_keterangan_fase"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ghm_info" />

                <TextView
                    style="@style/Text.GHM.Kecil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/ghm_info_perkiraan_muncul"
                    android:textColor="@color/ghm_tinta" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Aksi bawah. Padding bawah ditambah tinggi navigation bar / keyboard di TambahFaseActivity. -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpanFase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ghm_tombol_simpan_lihat_perkiraan" />
    </LinearLayout>

</LinearLayout>
