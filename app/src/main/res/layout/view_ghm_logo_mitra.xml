<?xml version="1.0" encoding="utf-8"?>
<!-- Logo mitra di kepala hijau (Masuk & Daftar). Figma: "Logo mitra". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ghm_logo_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/ghm_logo_diktisaintek"
        android:src="@drawable/logo_diktisaintek" />

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/ghm_logo_wow"
        android:src="@drawable/logo_wow" />

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/ghm_logo_unikom"
        android:src="@drawable/logo_unikom" />
</LinearLayout>
